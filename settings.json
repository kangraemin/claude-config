{
  "cleanupPeriodDays": 999999,
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "PATH": "/Users/ram/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "NOTION_DB_ID": "316d4919-b6eb-8170-8adb-f1a8f43c3ece",
    "WORKLOG_TIMING": "stop",
    "WORKLOG_DEST": "notion-only",
    "WORKLOG_GIT_TRACK": "false",
    "WORKLOG_LANG": "ko",
    "AI_WORKLOG_DIR": "/Users/ram/.claude",
    "LIBRARY_NOTION_DB_ID": "334d4919-b6eb-81bf-aee8-cffeb264f70d",
    "LIBRARY_USAGE_LOG": "aggregate",
    "OCTO_CAREFUL_MODE": "off",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(*)",
      "Write",
      "Edit",
      "Write(~/claude-library/**)",
      "Edit(~/claude-library/**)",
      "Write(/Users/ram/claude-library/**)",
      "Edit(/Users/ram/claude-library/**)",
      "Read",
      "Glob",
      "Grep",
      "mcp__stitch__*",
      "mcp__kaggle__*",
      "Bash(git worktree:*)",
      "Bash(git rebase:*)",
      "Bash(git merge --ff-only:*)",
      "Agent",
      "SendMessage",
      "Skill",
      "TaskStop",
      "NotebookEdit",
      "ToolSearch",
      "mcp__claude-library__*",
      "mcp__plugin_telegram_telegram__*",
      "mcp__claude_ai_Claude_Docs__*",
      "Monitor",
      "Artifact",
      "ArtifactData",
      "ArtifactComments",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ReadNotifications",
      "SendUserFile",
      "PushNotification",
      "ListAgents",
      "ScheduleWakeup",
      "mcp__context7__*",
      "mcp__figma__*",
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "WebFetch(*)",
      "TaskOutput",
      "Workflow",
      "AskUserQuestion",
      "EnterWorktree",
      "ExitWorktree",
      "RemoteTrigger",
      "DesignSync",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "FetchInboxMessage",
      "SendFeedback",
      "ReportFindings"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/ram/claude-library"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd $HOME/.claude && git pull --ff-only origin main 2>/dev/null || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/decision-inject.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/policy-changelog-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/library-activity-log.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Skill|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/library-trigger.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/stop.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/library-save-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/ralph-x-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/ram/.claude/hooks/ram-proxy-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/policy-changelog-check.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/library-usage-log.sh",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/library-save-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ram/.claude/hooks/library-trigger.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "telegram@claude-plugins-official": true,
    "ralph-x@ralph-x": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "octo@nyldn-plugins": false
  },
  "extraKnownMarketplaces": {
    "nyldn-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/nyldn/plugins.git"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "autoCompactWindow": 250000
    }
  },
  "autoCompactWindow": 250000,
  "promptSuggestionEnabled": false,
  "remote": {
    "defaultEnvironmentId": "env_014X3Bc9uz6hSCDhWP2niHih"
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "disableAutoMode": "disable",
  "theme": "dark",
  "preferredNotifChannel": "ghostty",
  "switchModelsOnFlag": false,
  "teammateMode": "tmux",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "kaggle": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://www.kaggle.com/mcp",
        "--header",
        "Authorization: Bearer 84cbed3f8e2d2b21f99b1bbb780af09a"
      ]
    },
    "claude-library": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "claude-library-mcp@latest"
      ],
      "env": {
        "LIBRARY_ROOT": "/Users/ram/claude-library"
      },
      "alwaysLoad": true
    }
  }
}
